{
  "rules": {
    ".read": "auth != null",
    "users": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "rooms": {
      "$roomId": {
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || data.child('players').child(auth.uid).exists())",
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || data.parent().parent().child('hostUid').val() === auth.uid)"
          }
        },
        "history": {
          ".write": "auth != null"
        }
      }
    },
    "decks": {
      "$deckId": {
        ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid || data.child('roomId').val() !== null)"
      }
    },
    "deckstore": {
      ".write": false
    }
  }
}
